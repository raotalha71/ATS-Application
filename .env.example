# ============================================================
#  RESUME ATS PLATFORM — ENVIRONMENT CONFIGURATION
# ============================================================

# --- LLM Provider Toggle ---
# true  = use local Ollama (Mistral 7B, no API key needed)
# false = use external API (set keys below)
USE_OLLAMA=true

# --- Ollama Settings (used when USE_OLLAMA=true) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral                  # Change to llama3, gemma2, etc. if needed

# --- Anthropic API (used when USE_OLLAMA=false) ---
# Uncomment and fill when switching to Claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- OpenAI API (alternative when USE_OLLAMA=false) ---
# Uncomment and fill when switching to OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# --- App Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_SIZE_MB=10

# --- FAISS Settings ---
FAISS_TOP_K=3                         # Number of chunks retrieved per query (keep low for speed)
CHUNK_SIZE=400                        # Characters per chunk
CHUNK_OVERLAP=50                      # Overlap between chunks

# --- Embedding Model ---
# Runs locally, no API key needed. Small + fast.
EMBEDDING_MODEL=all-MiniLM-L6-v2
