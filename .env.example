# ============================================================
#  RESUME ATS PLATFORM — ENVIRONMENT CONFIGURATION
# ============================================================

# --- LLM Provider Toggle ---
# Choose one: ollama, openai, anthropic
# ollama = local Mistral 7B through Ollama, no API key needed
LLM_PROVIDER=ollama

# Backward-compatible toggle. LLM_PROVIDER is preferred.
# true  = use local Ollama
# false = use external API if LLM_PROVIDER is not set
USE_OLLAMA=true

# --- Ollama Settings (used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral                  # Change to llama3, gemma2, etc. if needed

# --- Anthropic API (used when LLM_PROVIDER=anthropic) ---
# Fill these when switching to Claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- OpenAI API (used when LLM_PROVIDER=openai) ---
# Fill these when switching to OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# --- App Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_SIZE_MB=10
STORAGE_DIR=storage                    # SQLite DB, FAISS indexes, and chunk JSON files

# --- FAISS Settings ---
FAISS_TOP_K=3                         # Number of chunks retrieved per query (keep low for speed)
CHUNK_SIZE=400                        # Characters per chunk
CHUNK_OVERLAP=50                      # Overlap between chunks

# --- Embedding Model ---
# Runs locally, no API key needed. Small + fast.
EMBEDDING_MODEL=all-MiniLM-L6-v2
